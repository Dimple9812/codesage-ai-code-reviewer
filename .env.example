# Copy to .env and fill in. Never commit .env. All values below are placeholders.

# --- Database (used by docker compose for both PostgreSQL and the backend) ---
DATABASE_PASSWORD=change-me-to-a-long-random-password

# --- Public URL the browser uses (docker compose serves the app on port 3000) ---
APP_PUBLIC_URL=http://localhost:3000

# --- Encryption key for GitHub tokens / personal API keys at rest ---
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# --- GitHub OAuth App (https://github.com/settings/developers) ---
# Authorization callback URL: ${APP_PUBLIC_URL}/login/oauth2/code/github
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# 'repo' is needed to read private repositories with an OAuth App; use "read:user,user:email,public_repo" for public only.
GITHUB_OAUTH_SCOPES=read:user,user:email,repo

# --- GitHub webhooks (optional; pull_request events -> automatic reviews) ---
# Generate with: openssl rand -hex 32  and use the same value in the GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=

# --- AI provider (optional; without a key CodeSage runs static analysis only) ---
# anthropic | openai | gemini | openai-compatible
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
AI_API_KEY=
# Only for openai-compatible (or a gateway in front of the chosen provider)
AI_BASE_URL=
AI_TIMEOUT=120s
AI_MAX_RETRIES=3

# --- Review limits ---
REVIEW_MAX_FILES=60
REVIEW_MAX_FILE_BYTES=120000
REVIEW_MAX_TOTAL_BYTES=600000

# --- Security ---
# Set to true when served over HTTPS (production).
SESSION_COOKIE_SECURE=false
RATE_LIMIT_RPM=120
RATE_LIMIT_REVIEWS_PER_HOUR=30
SWAGGER_ENABLED=true
# Set to "ecs" or "logstash" for JSON structured logs.
LOG_FORMAT=
